#!/usr/bin/env sh

# Pre-commit 钩子：lint-staged + typecheck + 增量单测 + arch:check
# 注意：build 验证不在 pre-commit 中，由 CI 流水线覆盖。
# 原因：typecheck 已捕获大部分构建问题，build 步骤耗时较长（~11s），
# 且构建错误频率低。CI 包含完整的 build + E2E 验证。
# 单测策略：pre-commit 只跑受改动影响的测试（jest --onlyChanged / vitest --changed），
# 降低提交等待成本以减少 --no-verify 绕过动机；
# 全量单测由 pre-push（verify:critical）与 CI 兜底。

# ── Stage 1: lint-staged (parallel) ──────────────────────────────────────────
echo "🔍 Running lint-staged (api + web)..."
(cd apps/api && pnpm exec lint-staged) &
PID_API_LINT=$!
(cd apps/web && pnpm exec lint-staged) &
PID_WEB_LINT=$!
wait $PID_API_LINT $PID_WEB_LINT || { echo "❌ lint-staged failed"; exit 1; }

# ── Stage 2: typecheck (parallel) ────────────────────────────────────────────
echo "🔎 Running typecheck (api + web)..."
(cd apps/api && pnpm run typecheck) &
PID_API_TC=$!
(cd apps/web && pnpm run typecheck) &
PID_WEB_TC=$!
wait $PID_API_TC $PID_WEB_TC || { echo "❌ typecheck failed"; exit 1; }

# ── Stage 3: unit tests, affected scope only (parallel) ───────────────────────────────────────────
echo "🧪 Running affected unit tests (api + web)..."
(cd apps/api && pnpm exec jest --onlyChanged --passWithNoTests) &
PID_API_TEST=$!
(cd apps/web && pnpm exec vitest run --changed --passWithNoTests) &
PID_WEB_TEST=$!
wait $PID_API_TEST $PID_WEB_TEST || { echo "❌ unit tests failed"; exit 1; }

# ── Stage 4: arch:check (api only, ~2s) ──────────────────────────────────────
echo "🏗️  Running arch:check..."
(cd apps/api && pnpm run arch:check) || { echo "❌ arch:check failed"; exit 1; }

echo "✅ Pre-commit checks passed"

# ── Stage 5: 验证归因记录 ───────────────────────────────────────────────────
# 将 pre-commit 验证写入 .qoder/state/verify-ok，使 verify-gate 能识别
# husky 触发的验证已通过，闭合编辑-验证归因链路。
# 覆盖锚点：本次提交的暂存源文件列表（coveredFiles）。
node -e "
const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');
try {
  const stateDir = path.resolve('../.qoder/state');
  if (!fs.existsSync(stateDir)) process.exit(0);
  const staged = execSync('git diff --cached --name-only --diff-filter=ACM', { encoding: 'utf-8' })
    .trim().split('\n').filter(Boolean)
    .filter(f => /\.(ts|tsx|js|jsx|json|sql)$/i.test(f))
    .map(f => path.resolve(f).replace(/\\\\/g, '/'));
  const record = {
    at: new Date().toISOString(),
    command: 'verify:precommit',
    full: 'husky pre-commit (lint-staged + typecheck + jest --onlyChanged + vitest --changed + arch:check)',
    coveredFiles: staged
  };
  const okPath = path.join(stateDir, 'verify-ok');
  const existing = fs.existsSync(okPath) ? fs.readFileSync(okPath, 'utf-8').trim() : '';
  const entries = existing ? existing.split('\n').filter(Boolean) : [];
  entries.push(JSON.stringify(record));
  fs.writeFileSync(okPath, entries.slice(-20).join('\n') + '\n');
  // 清除 verify-pending：pre-commit 已验证全部暂存文件
  const pendingPath = path.join(stateDir, 'verify-pending');
  if (fs.existsSync(pendingPath)) {
    try { fs.unlinkSync(pendingPath); } catch {}
  }
} catch {}
" || true
