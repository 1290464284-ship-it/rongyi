PORT=3001
NODE_ENV=development

# 必须换成随机长密钥（至少 32 字符），禁止使用示例弱值
JWT_SECRET=replace-with-crypto-random-64-hex
JWT_EXPIRES_IN=7d

# [生产环境必填] 数据加密密钥（64 位十六进制）
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=your-64-hex-encryption-key

# 开发可选：显式指定数据目录（默认 apps/api/data）
# DATA_DIR=./apps/api/data

# 可选：显式指定数据库文件路径（默认 DATA_DIR/dental.sqlite）
# DB_PATH=./data/dental.sqlite

# CORS 允许的源，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# 可选：备份远程目录（用于自动备份同步）
# BACKUP_REMOTE_DIR=/path/to/backup

# 可选：Sentry DSN（生产环境建议配置）
# SENTRY_DSN=https://xxx@sentry.io/xxx

# 可选：Swagger 密码（未设置则生产环境禁用 Swagger）
# SWAGGER_PASSWORD=your-swagger-password

# 可选：.env 文件路径（Electron 场景使用）
# ENV_PATH=./.env
