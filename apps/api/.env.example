# ==============================================================================
# 牙科诊所管理系统 - API 环境变量示例文件
# ==============================================================================
# 使用说明：
#   1. 复制本文件为 .env
#   2. 根据实际情况修改配置值
#   3. 标注 [必填] 的项必须配置，[可选] 的项可使用默认值
#
# 生成密钥命令：
#   JWT_SECRET:     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================


# ==============================================================================
# 一、安全与认证（Security & Authentication）
# ==============================================================================

# [必填] JWT 签名密钥
# 至少 32 位随机字符串，生产环境强烈建议 48 位以上
# 格式：十六进制随机字符串
# 注意：密钥泄露将导致所有用户令牌可伪造，请妥善保管
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long

# [可选] JWT 令牌过期时间
# 默认值：7d（7天）
# 支持格式：60s / 2h / 7d / 30d
JWT_EXPIRES_IN=7d

# [生产环境必填] 数据加密密钥
# 用于加密敏感数据和备份文件（AES-256）
# 格式：64 位十六进制字符串（对应 32 字节密钥）
# 警告：此密钥丢失将导致加密数据永久不可解密，请务必备份！
ENCRYPTION_KEY=your-64-character-hex-encryption-key-000000000000000000000000

# [可选] bcrypt 密码哈希轮数
# 默认值：10
# 数值越高越安全但越慢，建议生产环境使用 12
BCRYPT_ROUNDS=10


# ==============================================================================
# 二、服务器配置（Server Configuration）
# ==============================================================================

# [可选] 运行环境
# 可选值：development / production / test
# 默认值：development
NODE_ENV=development

# [可选] API 服务监听端口
# 默认值：3001
PORT=3001

# [生产环境必填] CORS 允许的前端域名
# 多个域名用英文逗号分隔
# 示例：https://app.example.com,https://admin.example.com
# 警告：生产环境不要使用通配符 *
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# [可选] 是否信任反向代理
# 设为 1 时启用，用于 Nginx 等反向代理后正确获取客户端真实 IP
# 默认值：不启用
TRUST_PROXY=0


# ==============================================================================
# 三、数据存储（Data Storage）
# ==============================================================================

# [可选] 数据存储根目录
# 数据库、日志、备份等数据都将存储在此目录下
# 不设置时默认使用应用目录下的 data 文件夹
# 示例：/var/dental-data 或 D:\dental-data
DATA_DIR=

# [可选] SQLite 数据库文件完整路径
# 设置此项将覆盖 DATA_DIR 中的默认数据库位置
# 示例：/data/dental.sqlite 或 D:\data\dental.sqlite
DB_PATH=

# [可选] 自定义 .env 文件路径
# 用于指定非标准位置的环境变量文件
# 通常不需要设置
ENV_PATH=


# ==============================================================================
# 四、SQLite 数据库性能调优（SQLite Performance）
# ==============================================================================
# 一般情况下使用默认值即可，特殊性能需求可按需调整

# [可选] 数据库忙等待超时时间（毫秒）
# 默认值：5000（5秒）
SQLITE_BUSY_TIMEOUT_MS=5000

# [可选] SQLite 页面缓存大小
# 默认值：-50000（约 50MB，负数表示 KB 数）
# 增大此值可提升读取性能，但会占用更多内存
SQLITE_CACHE_SIZE=-50000

# [可选] 日志模式
# 默认值：WAL（写入更优）
# 可选值：DELETE / TRUNCATE / PERSIST / MEMORY / WAL / OFF
SQLITE_JOURNAL_MODE=WAL

# [可选] 磁盘同步级别
# 默认值：NORMAL（性能与安全的平衡）
# 可选值：OFF / NORMAL / FULL / EXTRA
SQLITE_SYNCHRONOUS=NORMAL

# [可选] 临时表存储位置
# 默认值：MEMORY（内存中，最快）
# 可选值：FILE / MEMORY
SQLITE_TEMP_STORE=MEMORY

# [可选] mmap 大小（字节）
# 默认值：268435456（256MB）
SQLITE_MMAP_SIZE=268435456

# [可选] WAL 自动检查点阈值（页数）
# 默认值：1000
SQLITE_WAL_AUTOCHECKPOINT=1000


# ==============================================================================
# 五、备份配置（Backup）
# ==============================================================================

# [可选] 异地备份目录
# 设置后自动备份会额外复制一份到此目录
# 建议设置为网络盘或其他物理磁盘路径
# 示例：/mnt/backup 或 E:\dental-backup
BACKUP_REMOTE_DIR=


# ==============================================================================
# 六、错误监控（Error Monitoring）
# ==============================================================================

# [可选] Sentry DSN
# 配置后启用 Sentry 错误监控，生产环境建议配置
# 留空则不启用（开发/测试环境默认不启用）
# 格式：https://<public_key>@<sentry_host>/<project_id>
SENTRY_DSN=

# [可选] Sentry 环境标识
# 用于区分不同环境的错误，默认使用 NODE_ENV
# 示例：production / staging / development
SENTRY_ENV=production

# [可选] Sentry 版本号
# 用于标识当前部署的版本，便于追踪哪个版本引入的问题
# 示例：v1.0.0 或 git commit hash
SENTRY_RELEASE=


# ==============================================================================
# 七、Electron 桌面端专用配置（Electron Desktop Only）
# ==============================================================================
# 以下配置通常由 Electron 主进程自动设置，手动部署时无需配置

# 是否以 Node.js 模式运行（Electron 子进程）
# ELECTRON_RUN_AS_NODE=1

# resources 目录路径
# RESOURCES_PATH=

# better-sqlite3 原生模块路径
# BETTER_SQLITE3_BINDINGS_PATH=

# 旧版数据库路径（升级迁移用）
# LEGACY_DB_PATH=


# ==============================================================================
# 八、测试配置（Test Only）
# ==============================================================================
# 以下配置仅用于自动化测试，正常使用时不要设置

# 使用内存数据库（测试用）
# TEST_DB_MEMORY=1
