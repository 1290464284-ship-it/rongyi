{
  "name": "@dental/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && ncc build dist/src/main.js -o bundle --no-cache",
    "start": "node dist/src/main.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:smoke": "jest --config jest.smoke.config.js",
    "test:migration": "jest --config jest.migration.config.js",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:strict": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test",
    "verify:full": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run test:e2e && pnpm run test:smoke && pnpm run test:migration",
    "reset-password": "ts-node src/cli/reset-password.ts",
    "seed": "ts-node src/db/seed/seed.ts",
    "seed:fresh": "ts-node src/db/seed/seed.ts --fresh",
    "seed:large": "ts-node src/db/seed/seed.ts --count 1000",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "health": "node scripts/code-health.mjs",
    "arch:check": "node scripts/validate-arch-rules.mjs",
    "tech-debt": "node scripts/tech-debt-tracker.mjs",
    "audit": "npm audit --audit-level=high",
    "backup": "node scripts/backup/backup.js",
    "backup:verify": "node scripts/backup/verify.js --list",
    "backup:cleanup": "node scripts/backup/cleanup.js --keep 30",
    "backup:restore": "node scripts/backup/restore.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dental/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@sentry/nestjs": "^10.67.0",
    "@sentry/node": "^10.67.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.1.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
