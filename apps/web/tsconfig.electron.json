{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["electron", "node"],
    "declaration": false
  },
  "include": ["electron/*.ts"],
  "exclude": ["node_modules"]
}
