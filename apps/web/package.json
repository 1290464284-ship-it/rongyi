{
  "name": "@dental/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:strict": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "electron:compile": "tsc -p tsconfig.electron.json && node scripts/rename-main.cjs",
    "electron:dev": "concurrently \"pnpm dev\" \"pnpm electron:compile && electron .\"",
    "electron:build": "pnpm build && pnpm electron:compile && electron-builder",
    "electron:pack": "pnpm build && pnpm electron:compile && electron-builder --dir",
    "electron:dist": "pnpm build && pnpm electron:compile && electron-builder --publish never"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dental/shared": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.7",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "sanitize-html": "^2.17.6",
    "electron-updater": "^6.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.21",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.7.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.dental.clinic",
    "productName": "牙科管家",
    "directories": {
      "output": "../../release-v2"
    },
    "files": [
      "electron/**/*",
      "dist-web/**/*",
      "public/**/*"
    ],
    "asarUnpack": [
      "dist-web/**/*"
    ],
    "extraResources": [
      {
        "from": "../api/bundle",
        "to": "api/bundle"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "牙科管家"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://releases.dental-clinic.local/updates/"
      }
    ]
  }
}
