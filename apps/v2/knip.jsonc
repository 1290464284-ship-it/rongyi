{
  // Round7 H-04: 死代码审计盲区说明
  // - legacy/schema/**：运行时文件系统资源，由 syncLegacySchema 在启动时读取建表（见 src/server/infrastructure/database.ts），不是死代码
  // - electron/preload.cjs：Electron 主进程入口链（package.json main → electron/main.cjs → preload.cjs），knip 的入口解析不覆盖
  // - src/domain/contracts/**：域契约唯一来源（96 个文件从它导入）。knip 实测报告 82 个导出无引用（18 常量 + 64 类型），
  //   属于保留的领域公共词汇表（审计 round7 H-04），刻意保留；如需死代码证明，以本文件注释为准
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/domain/contracts/index.ts",
    "legacy/schema/**/*.ts",
    "electron/preload.cjs"
  ],
  "ignore": [],
  "ignoreBinaries": ["openssl"]
}
