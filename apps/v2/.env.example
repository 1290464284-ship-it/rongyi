# ============================================================================
# Dental Clinic V2 — 环境变量参考
# ----------------------------------------------------------------------------
# 用法：代码不自动加载 .env（无 dotenv 依赖），请在 PowerShell / 系统环境
# 变量中设置，例如：$env:V2_PORT='3980'
# 打包版 Electron 会自动注入数据目录/日志/备份/密钥/端口等变量
# （apps/v2/electron/main.cjs），用户无需重复设置。
# 所有变量均按代码实际读取的集合整理（src/ + electron/，2026-08-05 核对）。
# ============================================================================

# ----- 服务（HTTP 监听） -----------------------------------------------------
# API 监听端口，默认 3180（src/server/main.ts）。
# 注意：Windows 上 3180 可能被系统"排除端口保留"（excludedportranges）占用，
# 若启动失败/端口不可用，改用其他端口，例如 V2_PORT=3980。
# 必须为 1-65535 的整数，否则启动直接报错退出。
V2_PORT=3180

# API 监听地址，默认 127.0.0.1 仅本机回环（src/server/main.ts）。
# 需要局域网访问时改为 0.0.0.0。
V2_HOST=127.0.0.1

# Node 运行环境：development | production | test（src/server/main.ts）。
# 打包版由 Electron 注入 production；production 下强制要求 V2_JWT_SECRET，
# 且绝不自动种默认管理员账号（dev 默认密码 REDACTED，见 V2_ADMIN_PASSWORD）。
NODE_ENV=development

# ----- 数据与迁移（SQLite / legacy） ----------------------------------------
# 数据目录，默认 <工作目录>/data（src/server/main.ts、src/server/infrastructure/database.ts）。
# 打包版由 Electron 注入 userData/data。
V2_DATA_DIR=

# V2 工作数据库 v2.sqlite 的完整路径覆盖，默认 <V2_DATA_DIR>/v2.sqlite。
# 设置后跳过 legacy 数据库首次导入与完整性校验流程（src/server/main.ts）。
V2_DB_PATH=

# 老克隆升级用：legacy 数据库 dental.sqlite 的路径（src/server/main.ts）。
# 该文件已从仓库移除（R2-P0-04），升级老克隆时指向仓库外部的文件；
# 首次启动自动导入 v2.sqlite，原文件只读、永不被修改。
V2_LEGACY_DB_PATH=

# legacy 表结构目录，默认 <工作目录>/legacy/schema（src/server/main.ts）。
# 打包版由 Electron 注入 resources/legacy/schema。
V2_LEGACY_SCHEMA_DIR=

# ----- 认证与安全 ------------------------------------------------------------
# JWT 签名密钥，建议至少 32 字符的随机串。
# development 未设置时每次启动临时随机生成（重启后登录态失效）；
# production 未设置或不足 32 字符时启动直接失败（src/server/main.ts）。
# 打包版由 Electron 自动生成并持久化（userData）。
V2_JWT_SECRET=

# 初始管理员密码（src/server/infrastructure/database.ts）。默认 REDACTED；
# production 下建议显式设置（production 绝不自动种默认账号，admin 缺失时拒绝启动）。
V2_ADMIN_PASSWORD=

# 备份加密密钥。设置后备份一律 AES 加密；未设置且未允许明文时创建备份会报错
# （src/server/application/service-modules/backup.ts、common.ts）。
# 打包版由 Electron 自动生成并持久化（userData）。
V2_BACKUP_KEY=

# =1 时允许创建明文（未加密）备份（src/server/application/service-modules/backup.ts）。
# 仅建议开发/测试环境使用；NODE_ENV=test 时默认即允许明文。
V2_ALLOW_PLAINTEXT_BACKUP=

# 额外 CORS 白名单，逗号分隔多个来源（src/server/http/app.ts）。
# 默认已放行本机回环（API 端口与 Vite 5180 端口）与 file:// 来源。
# 典型取值示例：http://localhost:3000,https://app.example.com
V2_CORS_ORIGIN=

# ----- 备份调度 --------------------------------------------------------------
# 自动备份目录，默认 <数据目录>/backups（src/server/main.ts）。
# 打包版由 Electron 注入 userData/backups。
V2_BACKUP_DIR=

# 自动备份间隔（毫秒），默认 86400000（24 小时）；
# 小于 60000 的取值回退为默认（src/server/main.ts）。
V2_AUTO_BACKUP_INTERVAL_MS=86400000

# 自动备份保留份数，默认 30，自动收敛到 1-365（src/server/main.ts）。
V2_AUTO_BACKUP_KEEP=30

# ----- 日志 -------------------------------------------------------------------
# 日志目录，默认 <工作目录>/logs（src/server/main.ts）。
# 打包版由 Electron 注入 userData/logs。
V2_LOG_DIR=

# ----- 微信集成 ---------------------------------------------------------------
# 微信网关地址 / AppID / AppSecret（src/server/application/service-modules/wechat.ts）。
# 三个值全部配置后才启用真实微信发送，否则降级为未配置（Unconfigured）实现。
V2_WECHAT_API_URL=
V2_WECHAT_APP_ID=
V2_WECHAT_APP_SECRET=

# ----- 桌面端（Electron） -----------------------------------------------------
# 开发模式下主窗口加载的渲染端地址，默认 http://localhost:5180（Vite dev 端口，
# apps/v2/electron/main.cjs）。打包版固定加载 dist-web/index.html，此变量无效。
V2_WEB_URL=

# Vite dev 端口，默认 5180（src/shared/constants.ts 的 DEFAULT_WEB_DEV_PORT；
# electron 的 CSP/白名单随 V2_WEB_DEV_PORT 或 V2_WEB_URL 联动）。
V2_WEB_DEV_PORT=

# 崩溃上报端点（apps/v2/electron/main.cjs）。必须为 https:// 地址，否则忽略；
# 未设置时不启用崩溃上报上传。
V2_CRASH_REPORT_URL=

# =1 时关闭打包版启动时的自动更新检查（apps/v2/electron/main.cjs）。
V2_DISABLE_AUTO_UPDATE=

# ----- 开发与测试 -------------------------------------------------------------
# =1 且 NODE_ENV=development 时，每次启动把 admin 账号重置为 admin/REDACTED
# （V2_ADMIN_PASSWORD 可覆盖，src/server/infrastructure/database.ts）。
# 生产环境绝不种默认账号。
V2_ALLOW_DEV_SEED=

# 仅测试用：=1 时模拟 legacy 数据库备份损坏，用于验证导入完整性校验
# （src/server/infrastructure/legacy-import.spec.ts）。正常运行无需设置。
V2_CORRUPT_LEGACY_BACKUP=
