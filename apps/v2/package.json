{
  "name": "@dental/v2",
  "version": "2.2.0",
  "description": "Dental Clinic V2 desktop application",
  "author": "Dental Clinic V2 Team",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build:api": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "pnpm build:api && pnpm build:web",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "start": "tsx src/server/main.ts",
    "electron:compile": "esbuild src/server/main.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:bcryptjs --external:jsonwebtoken --outfile=dist-electron/server.cjs",
    "electron:dev": "concurrently \"pnpm dev:web\" \"pnpm electron:compile && electron .\"",
    "electron:pack": "pnpm build && pnpm electron:compile && electron-builder --dir --publish never",
    "electron:dist": "pnpm build && pnpm electron:compile && electron-builder --publish never",
    "electron:dist:internal": "powershell -ExecutionPolicy Bypass -File scripts/build-internal-installer.ps1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:web": "vitest run src/web --coverage --config vite.web-coverage.config.ts",
    "smoke:api": "node scripts/api-smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "smoke:packaged-ui": "node scripts/packaged-ui-smoke.mjs",
    "smoke:packaged-ui-simulated": "node scripts/packaged-ui-simulated-smoke.mjs",
    "smoke:http-fuzz": "node scripts/http-fuzz-smoke.mjs",
    "smoke:multi-instance": "node scripts/multi-instance-smoke.mjs",
    "smoke:wechat-gateway": "node scripts/wechat-gateway-smoke.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "benchmark:load": "tsx scripts/benchmark-load.ts",
    "simulate:clinic-data": "tsx scripts/simulate-clinic-data.ts",
    "smoke:simulated-data": "node scripts/simulated-data-smoke.mjs",
    "smoke:permissions": "node scripts/permission-smoke.mjs",
    "smoke:all": "node scripts/run-smokes.mjs",
    "audit:security": "node scripts/audit.mjs",
    "verify:database": "node scripts/verify-database.mjs",
    "delivery:drill": "node scripts/delivery-drill.mjs",
    "disaster:drill": "node scripts/disaster-drill.mjs",
    "drill:legacy-dirty": "node scripts/legacy-dirty-drill.mjs",
    "drill:crash": "node scripts/crash-drill.mjs",
    "drill:environment": "node scripts/environment-drill.mjs",
    "verify:foreign-keys": "node scripts/verify-foreign-keys.mjs",
    "repair:database": "node scripts/repair-database.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "clean:generated": "node scripts/clean-generated.mjs",
    "license:check": "node scripts/license-scan.mjs",
    "restore:backup": "node scripts/restore-backup.mjs",
    "installer:smoke": "powershell -ExecutionPolicy Bypass -File scripts/installer-smoke.ps1",
    "upgrade:smoke": "powershell -ExecutionPolicy Bypass -File scripts/upgrade-smoke.ps1",
    "verify:package": "node scripts/verify-package.mjs",
    "update:metadata": "node scripts/update-metadata.mjs",
    "verify:update": "node scripts/verify-update.mjs",
    "verify:remote": "node scripts/verify-remote-release.mjs",
    "verify:signature": "powershell -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "generate:legacy-resources": "node scripts/generate-legacy-resources.mjs",
    "ensure:legacy": "tsx scripts/ensure-legacy-db.ts",
    "preelectron:pack": "pnpm ensure:legacy",
    "preelectron:dist": "pnpm ensure:legacy",
    "sanitize:legacy": "node scripts/sanitize-legacy-db.mjs",
    "wait:services": "node scripts/wait-for-services.mjs",
    "artifact:name": "node scripts/artifact-name.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "electron-updater": "^6.3.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.dental.v2",
    "productName": "Dental Clinic V2",
    "artifactName": "Dental-Clinic-V2-Setup-${version}.${ext}",
    "directories": {
      "output": "release-v2"
    },
    "files": [
      "dist-web/**/*",
      "electron/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "legacy",
        "to": "legacy"
      }
    ],
    "win": {
      "verifyUpdateCodeSignature": true,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1290464284-ship-it",
        "repo": "rongyi"
      }
    ]
  }
}
